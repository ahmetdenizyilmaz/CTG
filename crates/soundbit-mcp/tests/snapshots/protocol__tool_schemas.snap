  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Lists the instrument presets: id, name, category, voice type and what each sounds like and suits (including which notes to play drums on). Add one with instrument_add_preset.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "category": {
          "description": "Only list this category, e.g. \"strings\", \"brass\", \"drums\", \"lead\", \"bass\". Lists\neverything when unset.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "preset_list"
  },
  {
    "annotations": null,
    "description": "Saves a new reusable copy of an instrument to CTG Studio's user preset library (Music/CTG Studio/presets, or CTG_PRESET_DIR). Never overwrites existing presets or changes the song. The saved id is available to preset_list, instrument_add_preset and composition recipes in desktop, CLI and AI.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "instrument_id": {
          "description": "Instrument in the current project to save as a reusable sound.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "instrument_id"
      ],
      "type": "object"
    },
    "name": "preset_save"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Explains the song model: note format, every voice type and its parameters, envelope ranges, chip profiles with their channels, scales and size limits. Call it once before composing.",
    "input_schema": {
      "properties": {},
      "type": "object"
    },
    "name": "reference_get"
  },
  {
    "annotations": null,
    "description": "Replaces the open song with a fully editable CTG composition in one undo step. Uses CTG's native and ZzFX preset instruments with motif development and voice leading. Supply editor_id and revision from `song_get`. Does not save or overwrite a file; history_undo restores the previous complete song.",
    "input_schema": {
      "$defs": {
        "BassRhythm": {
          "description": "Bass onset selection, always respecting the section's attack budget.",
          "oneOf": [
            {
              "const": "mixed",
              "description": "Choose a template or Euclidean rhythm per section.",
              "type": "string"
            },
            {
              "const": "template",
              "description": "Preserve a syncopated or driving template.",
              "type": "string"
            },
            {
              "const": "euclidean",
              "description": "Distribute attacks evenly and rotate toward the kick.",
              "type": "string"
            }
          ]
        },
        "ComposeConfig": {
          "additionalProperties": false,
          "description": "Repeatable composition recipe. Omitted fields use the documented defaults.",
          "properties": {
            "bass_hits": {
              "default": 7,
              "description": "Bass attacks per 16-step verse bar, 0-16. Sections scale this budget.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "bass_rhythm": {
              "$ref": "#/$defs/BassRhythm",
              "default": "mixed",
              "description": "Bass rhythm algorithm."
            },
            "bpm": {
              "default": 124,
              "description": "Tempo in beats per minute, 40-240.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "cadences": {
              "default": true,
              "description": "Coordinate phrase endings, dominant preparation and final tonic.",
              "type": "boolean"
            },
            "chord_colors": {
              "default": true,
              "description": "Add sevenths or ninths to suitable chords.",
              "type": "boolean"
            },
            "expressive_slides": {
              "default": false,
              "description": "Add deliberate pickups, slides and glissando to selected phrases.",
              "type": "boolean"
            },
            "form": {
              "$ref": "#/$defs/Form",
              "default": "standard",
              "description": "Short (16), standard (32), or extended (48) bars."
            },
            "instruments": {
              "$ref": "#/$defs/Palette",
              "default": {
                "bass": "pc98_opna_slap_bass",
                "emotional": "aloboi_cello_solo",
                "harmony": "trig_velvet_chord_pluck",
                "hat": "hihat_closed",
                "kick": "kick",
                "lead": "aloboi_warm_lead",
                "snare": "snare"
              },
              "description": "Native and `ZzFX` instrument preset IDs."
            },
            "key": {
              "default": "D",
              "description": "Root note name, e.g. C, F#, Bb.",
              "type": "string"
            },
            "modal_mixture": {
              "default": false,
              "description": "Borrow minor iv in a major-key bridge.",
              "type": "boolean"
            },
            "motif_development": {
              "default": true,
              "description": "Reuse and develop one melodic motif across sections.",
              "type": "boolean"
            },
            "neon_funk": {
              "default": false,
              "description": "Lock in syncopated octave bass and offbeat stabs for neon chiptune funk.",
              "type": "boolean"
            },
            "scale": {
              "default": "dorian",
              "description": "major, `natural_minor`, `harmonic_minor`, dorian, mixolydian, `major_pentatonic` or `minor_pentatonic`.",
              "type": "string"
            },
            "secondary_dominants": {
              "default": false,
              "description": "Use a dominant of the next chord at selected transitions.",
              "type": "boolean"
            },
            "seed": {
              "default": 42,
              "description": "Deterministic random seed. Identical settings yield identical notes.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "suspensions": {
              "default": true,
              "description": "Prepare and resolve a suspension at suitable bridge chord changes.",
              "type": "boolean"
            },
            "swing": {
              "default": 12,
              "description": "Native swing percentage, 0-60. Zero is straight.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "default": "New CTG composition",
              "description": "Project title, at most 160 characters.",
              "type": "string"
            },
            "vibe": {
              "$ref": "#/$defs/Vibe",
              "default": "funk",
              "description": "Groove and arrangement character."
            },
            "voice_leading": {
              "default": true,
              "description": "Prefer small melodic steps and smoothly connected chord voicings.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "Form": {
          "description": "Number of four-bar sections.",
          "oneOf": [
            {
              "const": "short",
              "description": "Four sections, 16 bars.",
              "type": "string"
            },
            {
              "const": "standard",
              "description": "Eight sections, 32 bars.",
              "type": "string"
            },
            {
              "const": "extended",
              "description": "Twelve sections, 48 bars.",
              "type": "string"
            }
          ]
        },
        "Palette": {
          "additionalProperties": false,
          "description": "Native preset ids for the seven lanes. Every built-in preset is selectable.",
          "properties": {
            "bass": {
              "default": "pc98_opna_slap_bass",
              "description": "Bass instrument.",
              "type": "string"
            },
            "emotional": {
              "default": "aloboi_cello_solo",
              "description": "Slower bridge melody.",
              "type": "string"
            },
            "harmony": {
              "default": "trig_velvet_chord_pluck",
              "description": "Chords and arpeggios.",
              "type": "string"
            },
            "hat": {
              "default": "hihat_closed",
              "description": "Closed hi-hat.",
              "type": "string"
            },
            "kick": {
              "default": "kick",
              "description": "Kick drum.",
              "type": "string"
            },
            "lead": {
              "default": "aloboi_warm_lead",
              "description": "Main hook instrument.",
              "type": "string"
            },
            "snare": {
              "default": "snare",
              "description": "Snare drum.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "Vibe": {
          "description": "Arrangement and groove character.",
          "oneOf": [
            {
              "const": "adventure",
              "description": "Tuneful, medium energy.",
              "type": "string"
            },
            {
              "const": "battle",
              "description": "Fast, driving rhythm.",
              "type": "string"
            },
            {
              "const": "dungeon",
              "description": "Sparse atmosphere.",
              "type": "string"
            },
            {
              "const": "title_screen",
              "description": "Welcoming melodic theme.",
              "type": "string"
            },
            {
              "const": "boss",
              "description": "Dense dramatic arrangement.",
              "type": "string"
            },
            {
              "const": "funk",
              "description": "Syncopated groove with a reflective bridge.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "config": {
          "$ref": "#/$defs/ComposeConfig",
          "description": "Composition recipe. Use {} for defaults; `composition_defaults` documents all controls."
        },
        "expected_editor_id": {
          "description": "Editor id from `song_get`. Prevents replacing a different newly opened project.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expected_revision": {
          "description": "Revision from `song_get`. Prevents overwriting concurrent human edits.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "config",
        "expected_editor_id",
        "expected_revision"
      ],
      "type": "object"
    },
    "name": "song_compose"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Returns the whole song: settings, instruments, patterns (with note counts), tracks with their clips, an arrangement grid (rows = tracks, columns = bars, cells = pattern ids), chip-profile problems and undo state.",
    "input_schema": {
      "properties": {},
      "type": "object"
    },
    "name": "song_get"
  },
  {
    "annotations": {
      "destructiveHint": true
    },
    "description": "Replaces the open song with a new, empty one. This clears the undo history. Fails if the current song has unsaved changes unless `discard_unsaved` is true; save it first with song_save.",
    "input_schema": {
      "$defs": {
        "ChipProfile": {
          "enum": [
            "free",
            "nes",
            "game_boy",
            "c64",
            "genesis"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bpm": {
          "description": "Tempo in beats per minute, 20-400. Defaults to 120.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "chip_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChipProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hardware style; defaults to \"free\"."
        },
        "discard_unsaved": {
          "default": false,
          "description": "Confirm discarding unsaved changes to the current song.",
          "type": "boolean"
        },
        "title": {
          "description": "Song title.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "song_new"
  },
  {
    "annotations": {
      "destructiveHint": true
    },
    "description": "Opens a project file from the workspace, replacing the open song and clearing the undo history. Fails if the current song has unsaved changes unless `discard_unsaved` is true.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "discard_unsaved": {
          "default": false,
          "description": "Confirm discarding unsaved changes to the current song.",
          "type": "boolean"
        },
        "path": {
          "description": "Path relative to the workspace (see `files_list`).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "song_open"
  },
  {
    "annotations": null,
    "description": "Saves the song as a project file in the workspace.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Path relative to the workspace, e.g. `songs/theme.sbproj`. Defaults to the file the song\nwas opened from or last saved to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "song_save"
  },
  {
    "annotations": null,
    "description": "Changes song-wide settings: title, author, tempo, grid, swing, key and scale, chip profile, loop region or reverb room. Only the given fields change; all changes are one undo step.",
    "input_schema": {
      "$defs": {
        "ChipProfile": {
          "enum": [
            "free",
            "nes",
            "game_boy",
            "c64",
            "genesis"
          ],
          "type": "string"
        },
        "ScaleKind": {
          "enum": [
            "chromatic",
            "major",
            "natural_minor",
            "harmonic_minor",
            "melodic_minor",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "locrian",
            "major_pentatonic",
            "minor_pentatonic",
            "blues",
            "whole_tone"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "author": {
          "description": "Author or artist.",
          "type": [
            "string",
            "null"
          ]
        },
        "beats_per_bar": {
          "description": "Beats per bar, 1-16. Fails if existing notes would no longer fit in a bar.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "bpm": {
          "description": "Tempo in beats per minute, 20-400.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "chip_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChipProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hardware style that limits tracks and voices; \"free\" removes limits."
        },
        "clear_loop": {
          "default": false,
          "description": "Remove the loop region.",
          "type": "boolean"
        },
        "description": {
          "description": "Free-form description.",
          "type": [
            "string",
            "null"
          ]
        },
        "loop_end": {
          "description": "Bar after the last looped bar.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "loop_start": {
          "description": "First bar of the loop region (set together with `loop_end`).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reverb_damping": {
          "description": "Reverb high-frequency damping in percent, 0-100: low is bright stone, high is soft.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reverb_size": {
          "description": "Size of the shared reverb room in percent, 0-100: 20 is a small room, 60 a hall, 90+ a\ncathedral. Instruments join the room through their `reverb_send_percent`.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scale_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScaleKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Scale kind."
        },
        "scale_root": {
          "description": "Key root, e.g. \"A\", \"F#\", \"Bb\".",
          "type": [
            "string",
            "null"
          ]
        },
        "steps_per_beat": {
          "description": "Grid resolution: steps per beat, 1-16 (4 = sixteenth notes). Fails if existing notes\nwould no longer fit in a bar.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "swing": {
          "description": "Swing in percent, 0-100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "description": "Song title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "name": "song_update"
  },
  {
    "annotations": null,
    "description": "Adds an empty track at the end. With a chip profile, track N plays on the profile's channel N (see reference_get).",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "muted": {
          "default": false,
          "description": "Start muted.",
          "type": "boolean"
        },
        "name": {
          "description": "Display name, e.g. \"Bass\".",
          "type": "string"
        },
        "volume": {
          "description": "Volume in percent, 0-100. Defaults to 80.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "track_add"
  },
  {
    "annotations": {
      "destructiveHint": true
    },
    "description": "Removes a track together with its clips. Later tracks move up one chip-profile channel.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Track id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "track_remove"
  },
  {
    "annotations": null,
    "description": "Renames, mutes/unmutes or changes the volume of a track.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Track id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "muted": {
          "description": "Mute or unmute.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "description": "New name.",
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "description": "Volume in percent, 0-100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "track_update"
  },
  {
    "annotations": null,
    "description": "Synthesizes continuous frequency waves (exact Hz, fractional Hz beating, continuous Hz glides, Aloboi warm analog tape-drift waves, and XY Oscilloscope Lissajous stereo waves) directly to a 16-bit stereo WAV file in the workspace.",
    "input_schema": {
      "$defs": {
        "WaveSegmentInput": {
          "description": "One continuous wave segment with fine-grained Hz, stereo XY ratio, and analog drift controls.",
          "properties": {
            "analog_drift_cents": {
              "default": 14.0,
              "description": "Aloboi-style analog tape wow/flutter depth in cents (0.0 to 60.0).",
              "format": "double",
              "type": "number"
            },
            "detune_hz": {
              "default": 0.0,
              "description": "Fine Hz offset added to the right channel (e.g. 0.5 Hz for slow 3D oscilloscope rotation or binaural beat).",
              "format": "double",
              "type": "number"
            },
            "duration_ms": {
              "description": "Segment duration in milliseconds (10 to 60000).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "end_hz": {
              "description": "Ending frequency in hertz (16.0 to 20000.0). Defaults to `start_hz` (steady pitch); set different for continuous Hz sweeps/glides.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "gain": {
              "default": 0.75,
              "description": "Segment amplitude in `[0.0, 1.0]`. Defaults to 0.75.",
              "format": "float",
              "type": "number"
            },
            "phase_deg": {
              "default": 90.0,
              "description": "Stereo phase offset in degrees (0 to 360; 90 produces circular XY quadrature on an oscilloscope).",
              "format": "double",
              "type": "number"
            },
            "start_hz": {
              "description": "Starting frequency in hertz (16.0 to 20000.0), e.g. 110.0 or 432.5.",
              "format": "double",
              "type": "number"
            },
            "waveform": {
              "default": "aloboi_warm",
              "description": "Waveform style: `\"sine\"`, `\"triangle\"`, `\"sawtooth\"`, `\"pulse\"`, `\"aloboi_warm\"` (warm analog drift + sub + chorus), or `\"oscilloscope_xy\"` (phase-locked XY Lissajous stereo).",
              "type": "string"
            },
            "xy_ratio": {
              "default": 1.0,
              "description": "Right-channel harmonic frequency multiplier relative to Left channel (e.g. 1.0 for circle, 1.5 for 3:2 Lissajous fifth, 1.3333 for 4:3 fourth).",
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "duration_ms",
            "start_hz"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Output WAV path relative to the workspace, e.g. `renders/aloboi_wave.wav`.",
          "type": "string"
        },
        "sample_rate": {
          "description": "Sample rate in hertz (8000 to 192000). Defaults to 48000.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "segments": {
          "description": "Ordered list of continuous wave segments to synthesize seamlessly (phase-continuous across segments).",
          "items": {
            "$ref": "#/$defs/WaveSegmentInput"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "segments"
      ],
      "type": "object"
    },
    "name": "wave_synthesize_hz"
  }
]
