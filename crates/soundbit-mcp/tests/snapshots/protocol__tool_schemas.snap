      "properties": {
        "id": {
          "description": "Pattern id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "pattern_remove"
  },
  {
    "annotations": null,
