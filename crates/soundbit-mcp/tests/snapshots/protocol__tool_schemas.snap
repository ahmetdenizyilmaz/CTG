  },
  {
    "annotations": null,
    "description": "Develops an existing motif with scale-degree transposition and/or contour inversion about its first note. Preserves timing, velocity, detuning and glides; one undo step. For borrowed/chromatic phrases use pattern_transpose to preserve exact semitone intervals.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "degrees": {
          "default": 0,
          "description": "Shift in scale degrees, -14 to 14. Zero leaves the register unchanged.",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "invert": {
          "default": false,
          "description": "Reflect the contour about the first note before shifting.",
          "type": "boolean"
        },
        "pattern_id": {
          "description": "Existing pattern id; changes all arrangement uses, with undo available.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pattern_id"
      ],
      "type": "object"
    },
    "name": "pattern_develop"
  },
  {
    "annotations": null,
    "description": "Copies a pattern under a new id, e.g. to make a variation of it.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Pattern to copy.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Name of the copy. Defaults to the original name plus \" copy\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "pattern_duplicate"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Returns a pattern's notes, a tracker grid (one row per step; note names where notes start, '|' while held, '.' when silent; chords use several columns) and where it is placed.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Pattern id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "pattern_get"
  },
  {
    "annotations": {
