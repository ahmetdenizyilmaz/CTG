                },
                "feedback": {
                  "description": "Operator 1 self-feedback 0-7.",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "operators": {
                  "description": "Up to four operators; missing ones are silent.",
                  "items": {
                    "$ref": "#/$defs/FmOperatorInput"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "fm",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "envelope": {
          "$ref": "#/$defs/EnvelopeInput",
          "description": "Amplitude envelope. New instruments default to a short, plucky envelope."
        },
        "filter": {
          "$ref": "#/$defs/FilterInput",
          "description": "Resonant filter."
        },
        "id": {
          "description": "Instrument id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "New name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pan": {
          "description": "Stereo position, -100 (left) to 100 (right).",
          "format": "int8",
          "maximum": 127,
          "minimum": -128,
          "type": [
            "integer",
            "null"
          ]
        },
        "pitch_envelope": {
          "$ref": "#/$defs/PitchEnvelopeInput",
          "description": "Pitch glide at the start of each note."
        },
        "reverb_send_percent": {
          "description": "Share sent to the song's reverb in percent, 0-100; 20-50 places an instrument in a\nroom, 0 keeps it dry (kicks and basses usually stay dry).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unison": {
          "$ref": "#/$defs/UnisonInput",
          "description": "Detuned copies of the voice."
        },
        "vibrato": {
          "$ref": "#/$defs/VibratoInput",
          "description": "Pitch wobble for held notes."
        },
        "voice": {
          "anyOf": [
            {
              "$ref": "#/$defs/VoiceInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "New sound source (replaces the whole voice)."
        },
        "volume": {
          "description": "Volume in percent, 0-100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "instrument_update"
  },
  {
    "annotations": null,
    "description": "Adds notes to a pattern, keeping the existing ones. Fails if a note overlaps an existing note of the same pitch.",
    "input_schema": {
      "$defs": {
        "NoteInput": {
          "description": "A note to write into a pattern.",
          "properties": {
            "detune_cents": {
              "description": "Microtonal pitch offset in cents (-4800 to 4800; 100 cents = 1 semitone).",
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768,
              "type": [
                "integer",
                "null"
              ]
            },
            "detune_hz": {
              "description": "Fine frequency offset in hertz (-2000.0 to 2000.0) added to the note's frequency (for binaural beats, Aloboi drift, and Oscilloscope phase rotation).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "glissando": {
              "default": false,
              "description": "Quantize the pitch slide to semitone steps.",
              "type": "boolean"
            },
            "hz": {
              "description": "Exact target frequency in hertz (20.0-20000.0). Overrides the pitch's base 12-TET frequency for micro-Hz / Aloboi / Oscilloscope tuning.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "length": {
              "default": 1,
              "description": "Duration in steps. Defaults to 1.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "note": {
              "description": "Note name with octave (\"C4\" is middle C; also \"F#3\", \"Bb5\") or exact frequency string (\"440Hz\", \"432.5Hz\").",
              "type": "string"
            },
            "slide_semitones": {
              "description": "Continuous linear pitch glide in semitones (-48 to 48) over the duration of the note (positive glides up for zoom-in/inflation, negative glides down for zoom-out/shrinking).",
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": [
                "integer",
                "null"
              ]
            },
            "start": {
              "description": "First step of the note, counted from 0.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "tail_steps": {
              "default": 0,
              "description": "Additional held steps beyond the visible note, across bar boundaries.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "velocity": {
              "description": "MIDI velocity 1-127. Defaults to 100.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "zzfx_effect": {
              "description": "Optional `ZzFX` tracker effect: {code: SU/SD/VB/DT/ST/PD/BC/TR, value: 0-255}."
            }
          },
          "required": [
            "note",
            "start"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Pattern id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "description": "The notes.",
          "items": {
            "$ref": "#/$defs/NoteInput"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "notes"
      ],
      "type": "object"
    },
    "name": "pattern_add_notes"
  },
  {
